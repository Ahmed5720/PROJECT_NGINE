	ivec3(1, 1, 1)
};
const uint hashK1 = 15823;
const uint hashK2 = 9737333;
const uint hashK3 = 440817757;


uint HashCell3D(ivec3 cell)
{
    const ivec3 blockSize = ivec3(50,50,50);
    ivec3 ucell = ivec3(cell + blockSize / 2);

    ivec3 localCell = ucell.x % blockSize;
    ivec3 blockID = ucell / blockSize;
    
    uint blockHash = blockID.x * hashK1 + blockID.y * hashK2 + blockID.z * hashK3;

    return localCell.x + blockSize.x * (localCell.y + blockSize.x * localCell.z) + blockHash;
}

uint KeyFromHash(uint hash, uint tableSize)
{
	return hash % tableSize;
}
ivec3 getCell3D(vec3 position , float radius)
{
	return ivec3(floor(position/ radius));
}

