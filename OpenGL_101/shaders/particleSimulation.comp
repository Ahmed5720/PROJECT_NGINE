// calculates density at pos given by calc_density. position is determined by thread idx
// to calculate density efficiently, we preform a neighbor search looking for the 27 cells sorrounding our cell
// each cell has a hash value which gives us a key to index into our spatial offsets
// spatial offsets tells us the offset of the index of the first particle in a cell.
// since the indices are sorted, we just increment the index to find the next particles in the given cell
// we keep doing that until the key of the next particle no longer matches the key of this cell, which means we exited the cell
// the density and near density accumulates across all those particles.
// we also skip a particle if its further than the square of the smoothing kernel's radius
vec2 calculate_density_at_pos(vec3 pos)
{	

	ivec3 currentCell = getCell3D(pos, smoothingRadius);
	float sqrRad = smoothingRadius * smoothingRadius;
	float density = 0;
	float nearDensity = 0;


    for (int i = 0; i < 27; i++)
    {
        uint hash = HashCell3D(currentCell + offsets3D[i]);
		uint key = KeyFromHash(hash, numParticles);
		uint currIdx = SpatialOffsets[key];

		while(currIdx < numParticles)
		{
			uint neighbourIndex = currIdx;
			currIdx++;

			uint neighbourKey = SpatialKeys[neighbourIndex];
			if(neighbourKey != key)
				break;
			vec3 neighbourPos = predictedPositions[neighbourIndex];
			vec3 offsetToNeighbour = neighbourPos - pos;
			float sqrDstToNeighbour = dot(offsetToNeighbour, offsetToNeighbour);

			if (sqrDstToNeighbour > sqrRad)
				continue;

			float dst = sqrt(sqrDstToNeighbour);
			density += DensityKernel(dst, smoothingRadius);
			nearDensity += NearDensityKernel(dst, smoothingRadius);
			
		}
    }

	return vec2(density, nearDensity);


}

void calc_densities()
{
	uint idx = gl_GlobalInvocationID.x;
    if (idx >= numParticles) return;

	vec3 position = predictedPositions[idx];
	calculate_density_at_pos(position);
}

