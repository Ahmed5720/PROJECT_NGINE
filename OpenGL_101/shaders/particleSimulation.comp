{
	uint index = gl_GlobalInvocationID.x;
	if(index >= numParticles) return;

	velocities[index] += vec3(0.0, gravity, 0.0) * deltaTime;
	predictedPositions[index] = positions[index] + velocities[index] * (1.0 / 120.0); 
}

