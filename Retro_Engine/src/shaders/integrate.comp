#version 430 core
layout(local_size_x = 64) in;

struct Particle { vec4 posLife; vec4 color; vec4 velPad; };
struct SPHData  { vec4 densPres; vec4 forcePad; };

layout(std430, binding = 1) buffer Particles { Particle particles[]; };
layout(std430, binding = 2) buffer SphData   { SPHData  sph[]; };

layout(std140, binding = 0) uniform SimulationParams {
    vec4 p0; vec4 p1; vec4 p2; vec4 boxMin; vec4 boxMax; vec4 kernel;
};

void main() {
    uint i = gl_GlobalInvocationID.x;
    uint count = uint(p0.z);
    if (i >= count) return;

    float dt     = p0.x;
    float bounce = p0.y;
    float g      = p0.w;
    float mass   = p1.z;

    vec3 pos = particles[i].posLife.xyz;
    vec3 vel = particles[i].velPad.xyz;

    float density = sph[i].densPres.x;
    vec3  force   = sph[i].forcePad.xyz;

    vec3 gravity = vec3(0.0, g * mass, 0.0);

    vel += dt * (force / density + gravity);
    pos += dt * vel;

    // box collision
    if (pos.x < boxMin.x) { pos.x = boxMin.x; vel.x =  abs(vel.x) * bounce; }
    else if (pos.x > boxMax.x) { pos.x = boxMax.x; vel.x = -abs(vel.x) * bounce; }

    if (pos.y < boxMin.y) { pos.y = boxMin.y; vel.y =  abs(vel.y) * bounce; }
    else if (pos.y > boxMax.y) { pos.y = boxMax.y; vel.y = -abs(vel.y) * bounce; }

    if (pos.z < boxMin.z) { pos.z = boxMin.z; vel.z =  abs(vel.z) * bounce; }
    else if (pos.z > boxMax.z) { pos.z = boxMax.z; vel.z = -abs(vel.z) * bounce; }

    particles[i].posLife.xyz = pos;
    particles[i].velPad.xyz  = vel;
}
