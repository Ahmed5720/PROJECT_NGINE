#version 430 core
layout(local_size_x = 64) in;

struct Particle {
    vec4 posLife; // xyz = pos, w = life
    vec4 color;
    vec4 velPad;  // xyz = vel, w = pad
};

struct SPHData {
    vec4 densPres; // x=density, y=pressure, z,w pad
    vec4 forcePad; // xyz=force, w pad
};

layout(std430, binding = 1) buffer Particles { Particle particles[]; };
layout(std430, binding = 2) buffer SphData   { SPHData  sph[]; };

layout(std140, binding = 0) uniform SimulationParams {
    vec4 p0; // (dt, bounce, count, gravity)
    vec4 p1; // (h, h2, mass, rest_density)
    vec4 p2; // (pressure_k, viscosity_k, pad, pad)
    vec4 boxMin; // xyz, pad
    vec4 boxMax; // xyz, pad
    vec4 kernel; // (poly6_const, spiky_const, pad, pad)
};

float poly6_kernel(float r2) {
    float h2 = p1.y;
    if (r2 >= h2) return 0.0;
    float x = (h2 - r2);
    return kernel.x * x * x * x; // pow(x,3)
}

void main() {
    uint i = gl_GlobalInvocationID.x;
    uint count = uint(p0.z);
    if (i >= count) return;

    vec3 pi = particles[i].posLife.xyz;

    float density = 0.0;
    for (uint j = 0u; j < count; ++j) {
        vec3 pj = particles[j].posLife.xyz;
        vec3 d = pi - pj;
        float r2 = dot(d, d);
        if (r2 < p1.y) {
            density += p1.z * poly6_kernel(r2); // mass * Wpoly6
        }
    }

    density = max(1e-6, density);
    float pressure = p2.x * (density - p1.w);

    sph[i].densPres = vec4(density, pressure, 0.0, 0.0);
    // force preserved for next pass
}
